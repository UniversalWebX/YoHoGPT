# Agent sandbox image: one container per agent run, started with --network none.
#   docker build -f deploy/Dockerfile.sandbox -t yohogpt/sandbox:latest .
FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive LANG=C.UTF-8
RUN apt-get update && apt-get install -y --no-install-recommends \
      bash coreutils git curl ca-certificates build-essential cmake pkg-config ripgrep jq \
      python3 python3-pip python3-venv python-is-python3 \
      nodejs npm golang-go rustc cargo default-jdk-headless ruby php-cli \
    && rm -rf /var/lib/apt/lists/* \
    && pip3 install --break-system-packages pytest ruff mypy \
    && npm install -g typescript ts-node jest
RUN useradd -m -u 1000 agent
USER agent
WORKDIR /workspace
CMD ["sleep", "infinity"]
